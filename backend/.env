# ============================================
# FINOVATE 2026 - Backend Environment Variables
# ============================================

# ---------- DATABASE (Local PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=swiftbank_user
DB_PASSWORD=swiftbank2026
DB_DATABASE=swiftbank_db
DB_SYNCHRONIZE=true

# ---------- SUPABASE (File Storage - Optional) ----------
# If you want to keep Supabase for file uploads, update these
SUPABASE_URL=https://your-project-id.supabase.co/rest/v1/
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=documents

# ---------- JWT AUTHENTICATION ----------
JWT_SECRET=finovate2026_secret_key_change_me
JWT_EXPIRES_IN=7d

# ---------- SERVER ----------
PORT=3000
NODE_ENV=development

# ---------- FRONTEND ----------
FRONTEND_URL=http://localhost:8080
